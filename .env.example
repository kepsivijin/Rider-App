# Database
DATABASE_URL=postgresql://rideshare:rideshare123@localhost:5432/rideshare_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secret
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Firebase Cloud Messaging
FCM_SERVER_KEY=your-fcm-server-key
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# SMS Gateway (MSG91 or Twilio)
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=RIDESH

# App Settings
APP_NAME=Kanyakumari RideShare
APP_VERSION=1.0.0
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Service area: Eramanthurai, Vallavilai, Nithiravilai, Marthandam surroundings
SERVICE_AREA_BOUNDARY=[[76.948,8.238],[77.265,8.238],[77.265,8.425],[76.948,8.425],[76.948,8.238]]
